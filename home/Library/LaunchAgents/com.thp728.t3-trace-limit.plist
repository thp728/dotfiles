<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Caps T3's server traces at 40 files of 10 MB, about 400 MB: one or two busy days. It deletes
     nothing itself. T3 rotates by size, and at its next start removes files numbered above the
     cap. T3's default is 10; 150 filled about 1.5 GB in three busy days. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.thp728.t3-trace-limit</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/launchctl</string>
		<string>setenv</string>
		<string>T3CODE_TRACE_MAX_FILES</string>
		<string>40</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
