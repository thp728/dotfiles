{{- if .laptopHost -}}
# The dev's personal Windows laptop, reached over the home Wi-Fi. Both machines have to be on the
# same network. The windows-lan-ssh skill covers how agents use it.
Host personal-laptop
    HostName {{ .laptopHost }}
    # known_hosts keys the laptop by this name, not its address, so the address can change and an
    # address that reaches another machine fails the host key check.
    HostKeyAlias personal-laptop
    User "{{ .laptopUser }}"
    IdentityFile {{ .laptopKey }}
    IdentitiesOnly yes
    ConnectTimeout 5
    # One shared connection for every command, kept open 10 minutes after the last one.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
{{ end -}}
