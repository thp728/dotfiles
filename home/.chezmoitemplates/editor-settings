{{- /*
Sets the keys in .editorSettings (from .chezmoidata/editor.jsonc) in an editor's settings.json and
keeps every other key. While the keys already match, the file passes through untouched, comments
and order included. Otherwise it's rewritten as plain JSON, which drops its comments.
*/ -}}
{{- $current := dict }}
{{- if .chezmoi.stdin }}{{ $current = fromJsonc .chezmoi.stdin }}{{ end }}
{{- $merged := dict }}
{{- range $key, $value := $current }}{{ $_ := set $merged $key $value }}{{ end }}
{{- range $key, $value := .editorSettings }}{{ $_ := set $merged $key $value }}{{ end }}
{{- if eq (toJson $current) (toJson $merged) }}
{{- .chezmoi.stdin }}
{{- else }}
{{- toPrettyJson $merged }}{{ "\n" }}
{{- end -}}
