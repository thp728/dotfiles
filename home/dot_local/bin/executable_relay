#!/bin/sh
# Pushes a repo built on this machine to GitHub through a mirror on the personal laptop, which
# holds the GitHub sign-in. Run inside the repo. `relay init` also installs the pre-push hook that
# checks commits for blocked email addresses and secrets before they leave this machine.
#   relay init [--create] [name]  set up the mirror and the `laptop` remote. --create also
#                                 creates the private GitHub repo thp728/<name> if it's missing.
#   relay push [branch]           push a branch, the current one by default, through the mirror
#   relay fetch                   update the mirror from GitHub, then fetch it here
set -eu

host=personal-laptop
owner=thp728
wsl="wsl -d Ubuntu --shell-type login --"

# Runs a shell script on the laptop's Ubuntu as base64, so no quoting layer can mangle it.
on_laptop() {
  b64=$(printf '%s' "$1" | base64 | tr -d '\n')
  ssh "$host" "wsl -d Ubuntu -- zsh -l -c 'echo $b64 | base64 -d | zsh -l'"
}

top=$(git rev-parse --show-toplevel)
cmd=${1:-help}
[ $# -gt 0 ] && shift

email=$(git config user.email || true)
case "$cmd" in
  init | push)
    case "$email" in
      *@users.noreply.github.com) ;;
      *) echo "!! user.email here is '$email'. Set the GitHub noreply identity in this repo first."; exit 1 ;;
    esac
    ;;
esac

case "$cmd" in
  init)
    create=false
    if [ "${1:-}" = "--create" ]; then create=true; shift; fi
    name=${1:-$(basename "$top")}
    mirror="/home/$owner/relay/$name.git"
    on_laptop "
      set -e
      m=$mirror
      if [ ! -d \"\$m\" ]; then
        if ! gh repo view $owner/$name >/dev/null 2>&1; then
          if [ $create = true ]; then gh repo create $owner/$name --private >/dev/null && echo 'created private GitHub repo $owner/$name'
          else echo '!! GitHub has no $owner/$name. Rerun with --create to make it private.'; exit 1; fi
        fi
        git init -q --bare \"\$m\"
        git -C \"\$m\" remote add origin https://github.com/$owner/$name.git
        git -C \"\$m\" config --unset-all remote.origin.fetch
        git -C \"\$m\" fetch -q origin '+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*' 2>/dev/null || true
      fi
      ln -sf ~/.local/share/relay/pre-receive \"\$m/hooks/pre-receive\"
      echo \"mirror ready: \$m -> \$(git -C \"\$m\" config remote.origin.url)\"
    "
    git config relay.name "$name"
    # A wrapper, not a symlink: a hook manager that rewrites its hooks would write through a
    # symlink into the shared hook every repo uses.
    hooks=$(git rev-parse --git-path hooks)
    if [ "$(basename "$hooks")" = _ ] && [ "$(basename "$(dirname "$hooks")")" = .husky ]; then
      # Husky rewrites everything in .husky/_ on install, and its stubs run .husky/<hook>.
      hook="$(dirname "$hooks")/pre-push"
      [ -L "$hooks/pre-push" ] && rm "$hooks/pre-push"
      [ -e "$hooks/pre-push" ] || cp "$hooks/pre-commit" "$hooks/pre-push"
      exclude=$(git rev-parse --git-path info/exclude)
      grep -qxF /.husky/pre-push "$exclude" 2>/dev/null || echo /.husky/pre-push >> "$exclude"
    else
      hook="$hooks/pre-push"
    fi
    if [ -f "$hook" ] && [ ! -L "$hook" ] && ! grep -q relay/pre-push "$hook"; then
      echo "!! $hook already exists. Add a line to it that runs ~/.local/share/relay/pre-push \"\$@\"."
      exit 1
    fi
    rm -f "$hook"
    printf '#!/bin/sh\nexec "$HOME/.local/share/relay/pre-push" "$@"\n' > "$hook"
    chmod +x "$hook"
    git remote remove laptop 2>/dev/null || true
    git remote add laptop "$host:$mirror"
    git config remote.laptop.receivepack "$wsl git-receive-pack"
    git config remote.laptop.uploadpack "$wsl git-upload-pack"
    git fetch -q laptop
    echo "remote 'laptop' added. Next: relay push"
    ;;
  push)
    git config relay.name >/dev/null || { echo "!! run 'relay init' first"; exit 1; }
    branch=${1:-$(git branch --show-current)}
    git push -u laptop "$branch"
    ;;
  fetch)
    name=$(git config relay.name) || { echo "!! run 'relay init' first"; exit 1; }
    on_laptop "git -C /home/$owner/relay/$name.git fetch -q --prune origin '+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*'"
    git fetch --prune laptop
    git status -sb | head -1
    ;;
  *)
    sed -n '2,/^set /s/^# \{0,1\}//p' "$0"
    ;;
esac
