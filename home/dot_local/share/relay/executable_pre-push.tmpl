#!/usr/bin/env bash
# pre-push hook that `relay init` installs in each repo it sets up. For the `laptop` remote only:
# rejects commits whose author or committer email matches a `relay.blockedEmail` pattern from git
# config, and anything gitleaks flags, before the commits leave this machine. A machine's
# ~/.config/gitleaks/work.toml layers its own rules on the repo's, so the scan prefers it.
set -euo pipefail

[ "$1" = laptop ] || exit 0
zero=0000000000000000000000000000000000000000
rules="$HOME/.config/gitleaks/work.toml"
[ -f "$rules" ] || rules={{ joinPath .chezmoi.workingTree ".gitleaks.toml" | quote }}
blocked=$(git config --get-all relay.blockedEmail || true)
{{- if .work }}
if [ -z "$blocked" ]; then
  echo "relay: no relay.blockedEmail pattern is set, so the email check can't run. Set one in ~/.config/git/local.gitconfig."
  exit 1
fi
{{- end }}

while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha --not --remotes=laptop"; else range="$rsha..$lsha"; fi
  # A variable, not a pipe: grep -q exits at its first match, and under pipefail git log's SIGPIPE
  # would then turn the match into a miss.
  emails=$(git log --format='%ae%n%ce' $range | sort -u)
  if [ -n "$blocked" ] && grep -qiE -f <(printf '%s\n' "$blocked") <<<"$emails"; then
    echo "relay: $lref has commits by an address relay.blockedEmail blocks. Rewrite them with git filter-repo first."
    exit 1
  fi
  if ! gitleaks git --no-banner --redact --log-level=warn --config "$rules" --log-opts="$range" . >&2; then
    echo "relay: gitleaks flagged $lref. Remove the finding from history, then push again."
    exit 1
  fi
done
