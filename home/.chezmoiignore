{{- if ne .chezmoi.os "windows" }}
# Windows-side settings: WSL's VM and Windows apps.
.wslconfig
AppData
{{- else }}
# Windows gets only its own layer: WSL's settings, VS Code's settings, and the app and extension
# scripts. Everything else lives in Ubuntu, and Windows keeps its own .gitconfig.
.*
!.wslconfig
!.t3
{{- end }}
{{- if eq .chezmoi.os "linux" }}
# No T3 desktop app on Linux; its server keeps its own settings.
.t3
# T3's scheduled tasks run in the Mac's T3. The laptop's T3 has none, so sources here would have
# its `t3-schedules check` ask for duplicates of the Mac's tasks.
.config/t3-schedules
{{- end }}
{{- if ne .chezmoi.os "linux" }}
# Linux only: the login banner switch, and BROWSER for WSL.
.hushlogin
.local/bin/wsl-browser
{{- end }}
{{- if not .laptopHost }}
# relay pushes through the personal laptop, so only a machine that knows its address gets it.
# Its pre-push scanner goes everywhere: on the laptop it guards pushes into the local mirrors.
.local/bin/relay
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
# Ghostty has no Windows or WSL build.
.config/ghostty
# macOS app settings, such as the editors'.
Library
{{- end }}

# Never versioned: auth, sessions, history, databases, caches and memories. Agent folders are
# ignored except the files listed with !, so whatever a tool adds later stays out. To manage
# another file in one of them, add a ! line here first.
.codex/*
!.codex/AGENTS.md
!.codex/config.toml
.claude/*
!.claude/CLAUDE.md
!.claude/skills
.claude/skills/*
!.claude/skills/t3-threads
!.claude/skills/inbox
!.claude/settings.json
.claude.json
{{- if eq .chezmoi.os "linux" }}
.config/opencode/*
!.config/opencode/AGENTS.md
!.config/opencode/opencode.jsonc
!.config/opencode/cli.json
{{- else }}
# opencode runs only on Linux machines, which are personal ones.
.config/opencode
{{- end }}
.local/share/opencode
{{- if .work }}
# Only the work machine runs Cursor, and its hooks bring AGENTS.md and unslop into app sessions.
.cursor/*
!.cursor/hooks.json
!.cursor/hooks
{{- else }}
.cursor
{{- end }}
# T3 Code: only the desktop app's UI settings.
.t3/*
!.t3/userdata
.t3/userdata/*
!.t3/userdata/client-settings.json
.copilot

# A machine's own agent instructions, and the improvements log, which can quote its sessions.
.agents/AGENTS.work.md
.agents/improvements.md

# Credentials and history outside the agent folders. Of ~/.ssh, only config is managed.
.ssh/*
!.ssh/config
.netrc
.npmrc
.vstsnpmauthrc
.docker/config.json
.azure
.config/gh/hosts.yml
.zsh_history
.local/share/atuin
